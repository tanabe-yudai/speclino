{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speclino.dev/schemas/run-manifest.schema.json",
  "$defs": {
    "AnalysisLimits": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "直接呼出しを展開する深さ",
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "max_paths": {
          "minimum": 1,
          "title": "Max Paths",
          "type": "integer"
        },
        "solver_timeout_ms": {
          "minimum": 1,
          "title": "Solver Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "depth",
        "max_paths",
        "solver_timeout_ms"
      ],
      "title": "AnalysisLimits",
      "type": "object"
    },
    "BehaviorAnalysis": {
      "additionalProperties": false,
      "description": "増分解析（S41c）の記録。再利用は「解析していない」ことなので必ず記録して隠さない。",
      "properties": {
        "behavior_id": {
          "minLength": 1,
          "title": "Behavior Id",
          "type": "string"
        },
        "reachability": {
          "$ref": "#/$defs/ReachabilityDigest",
          "description": "到達関数群のソースハッシュ（未解決呼出しも含め隠さず記録する）"
        },
        "inputs_hash": {
          "description": "仕様・domain・bindings・contracts の内容ハッシュ",
          "minLength": 1,
          "title": "Inputs Hash",
          "type": "string"
        },
        "reused_from_base": {
          "description": "base の Code IR を再利用したか",
          "title": "Reused From Base",
          "type": "boolean"
        },
        "reason": {
          "description": "再利用した／しなかった理由（人が読める説明）",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "behavior_id",
        "reachability",
        "inputs_hash",
        "reused_from_base",
        "reason"
      ],
      "title": "BehaviorAnalysis",
      "type": "object"
    },
    "ReachabilityDigest": {
      "additionalProperties": false,
      "description": "到達関数群のソースハッシュ（S41c 増分解析）。`analysis.reachability` の戻り値。\n\nbehavior の入口から静的にたどれる関数群と、それを含むモジュール群の import 推移閉包\n（解析器がモジュールを読む経路は import 経由しかない）を正規化して連結したハッシュ。\nbase と head でこれが一致すれば（かつ入力の同一性も一致すれば）Code IR の再解析を省ける。",
      "properties": {
        "source_hash": {
          "description": "sha256:... 形式",
          "minLength": 1,
          "title": "Source Hash",
          "type": "string"
        },
        "functions": {
          "description": "到達した関数の完全修飾名（ソート済み）",
          "items": {
            "type": "string"
          },
          "title": "Functions",
          "type": "array"
        },
        "modules": {
          "description": "ハッシュに含めたモジュールの完全修飾名（ソート済み、import の推移閉包）",
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "unresolved_calls": {
          "description": "静的に解決できなかった呼出し式（self.xxx 等）。変わればハッシュも変わる",
          "items": {
            "type": "string"
          },
          "title": "Unresolved Calls",
          "type": "array"
        }
      },
      "required": [
        "source_hash"
      ],
      "title": "ReachabilityDigest",
      "type": "object"
    },
    "RunInputs": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "head_commit": {
          "minLength": 1,
          "title": "Head Commit",
          "type": "string"
        },
        "base_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Commit"
        },
        "spec_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec Content Hash"
        },
        "spec_ir_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec Ir Hash"
        },
        "bindings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bindings Hash"
        },
        "domain_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Hash"
        },
        "contracts_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contracts Hash"
        },
        "policy_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Hash"
        },
        "code_ir_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "--code-ir 入力時のハッシュ",
          "title": "Code Ir Hash"
        }
      },
      "required": [
        "head_commit"
      ],
      "title": "RunInputs",
      "type": "object"
    },
    "RunVersions": {
      "additionalProperties": false,
      "properties": {
        "speclino": {
          "title": "Speclino",
          "type": "string"
        },
        "analyzer": {
          "title": "Analyzer",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "solver": {
          "title": "Solver",
          "type": "string"
        },
        "settings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settings Hash"
        }
      },
      "required": [
        "speclino",
        "analyzer",
        "engine",
        "solver"
      ],
      "title": "RunVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/RunInputs"
    },
    "versions": {
      "$ref": "#/$defs/RunVersions"
    },
    "limits": {
      "$ref": "#/$defs/AnalysisLimits"
    },
    "fail_on": {
      "description": "ゲート失敗にする verdict",
      "items": {
        "type": "string"
      },
      "title": "Fail On",
      "type": "array"
    },
    "mode": {
      "default": "advisory",
      "enum": [
        "advisory",
        "blocking"
      ],
      "title": "Mode",
      "type": "string"
    },
    "analysis": {
      "description": "behavior ごとの増分解析の記録（S41c）",
      "items": {
        "$ref": "#/$defs/BehaviorAnalysis"
      },
      "title": "Analysis",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "inputs",
    "versions",
    "limits"
  ],
  "title": "RunManifest",
  "type": "object"
}
